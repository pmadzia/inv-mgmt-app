<div class="d-flex justify-content-center py-4">
  <div class="auth-box w-100 px-3">
    <div class="text-center mb-4 py-1">
          <br><br>
      <h1 class="h4 fw-semibold mt-4">Sign up to Inventories</h1>
    </div>

    <div class="d-grid gap-2">
    <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
                                         class: "btn btn-secondary border w-100 fw-semibold" do %>
      <i class="bi bi-google me-2"></i>Continue with Google
    <% end %>
    <%= button_to "/auth/github", method: :post, data: { turbo: false },
                                  class: "btn btn-secondary border w-100 fw-semibold" do %>
      <i class="bi bi-github me-2"></i>Continue with GitHub
    <% end %>
    </div>

    <div class="d-flex align-items-center text-secondary my-3">
      <hr class="flex-grow-1 m-0">
      <span class="px-3 small">or</span>
      <hr class="flex-grow-1 m-0">
    </div>

    <% if notice %><div class="text-center alert alert-info py-2"><%= notice %></div><% end %>

    <%= form_with model: @user, url: registration_path do |form| %>
      <div class="mb-3">
        <%= form.label :name, "Name", class: "form-label fw-semibold" %>
        <%= form.text_field :name, value: params[:name], class: "form-control",
                           required: true, autofocus: true, autocomplete: "name" %>
      </div>

      <div class="mb-3">
        <%= form.label :email, "Email address", class: "form-label fw-semibold
                                                        #{'is-invalid' if @user.errors[:email_address].any?}" %>
        <%= form.email_field :email_address, value: params[:email_address], class: "form-control",
                           required: true, autofocus: true, autocomplete: "email" %>

        <% if (message = @user.errors[:email_address].first) %>
          <div class="invalid-feedback"><%= message %></div>
        <% end %>
      </div>
      <div class="mb-3">
        <%= form.label :password, "Password", class: "form-label fw-semibold" %>
        <%= form.password_field :password, class: "form-control",
                              required: true, autocomplete: "current-password", minlength: 8, maxlength: 72 %>
        <div class="form-text">At least 8 characters.</div>
      </div>
      <%= form.submit "Sign in", class: "btn btn-success w-100 fw-semibold" %>
    <% end %>

    <p class="text-center mt-4 mb-0">
      Already registered?
      <%= link_to "Sign in", new_session_path, class: "text-decoration-none" %>
    </p>
  </div>
</div>
