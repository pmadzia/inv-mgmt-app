<div class="d-flex align-items-center gap-2">
  <div class="dropdown">
    <button type="button"
            class="btn text-body btn-light px-2"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="<%= t(".change_language") %>">
      <i class="bi bi-translate fs-6"></i>
      <span class="fw-semibold"><%= I18n.locale.to_s.upcase %></span>
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
      <% I18n.available_locales.each do |locale| %>
        <li>
          <%= link_to t(locale, scope: "locales"),
                      url_for(locale: locale),
                      class: "dropdown-item #{'active' if I18n.locale == locale}" %>
        </li>
      <% end %>
    </ul>
  </div>

  <% other_theme = get_current_theme == "dark" ? "light" : "dark" %>
  <%= button_to request.path,
                method: :get,
                params: request.query_parameters.merge(theme: other_theme),
                class: "btn text-body btn-light px-2",
                form: { class: "d-inline" } do %>
    <i class="bi <%= other_theme == "light" ? "bi-sun" : "bi-moon" %> fs-6"></i>
  <% end %>
</div>
