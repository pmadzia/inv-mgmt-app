<% flashes = {
  notice: "alert-success",
  alert: "alert-danger"
} %>
<div id="flash">
<% flashes.each do |type, alert_class| %>
  <% if flash[type].present? %>
    <div class="flash-box w-100 px-3">
      <div class="alert <%= alert_class %> alert-dismissible fade show text-center py-2 px-4"
        role="alert">
          <%= flash[type] %>
          <button type="button" class="btn-close btn-close-size py-2 px-2" data-bs-dismiss="alert"
            aria-label="Close"></button>
        </div>
    </div>
  <% end %>
<% end %>
</div>
