<div class="border-bottom mb-4">
  <header class="container d-flex flex-column flex-md-row align-items-center
    justify-content-center justify-content-md-between
    py-3 gap-3">

    <div class="d-flex align-items-center gap-1">
      <%= link_to root_path, class: "text-body text-decoration-none",
                             aria: { label: "Inventories home" } do %>
        <i class="bi bi-box-seam fs-4 logo-lower"></i>
        <span class="fs-4 fw-semibold mx-1">Inventories</span>
      <% end %>
    </div>

    <div class="d-flex align-items-center gap-2">
      <% if authenticated? %>
        <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn btn-dark fw-semibold" %>
      <% else %>
        <%= link_to t(".sign_in"), new_session_path, class: "btn btn-light fw-semibold" %>
        <%= link_to t(".sign_up"), new_registration_path, class: "btn btn-dark fw-semibold" %>
      <% end %>

      <div class="vr vr-short mx-2"></div>

      <%= render "shared/preferences" %>
    </div>
  </header>
</div>
