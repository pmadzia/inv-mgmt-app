<div class="d-flex justify-content-center py-4">
  <div class="auth-box w-100 px-3 py-1">
    <div class="text-center mb-4">
      <%= link_to root_path, class: "text-body text-decoration-none",
                             aria: { label: t(".icon_label") } do %>
        <i class="bi bi-box-seam fs-1"></i>
      <% end %>

      <h1 class="h5 fw-semibold mt-3"><%= t(".title") %></h1>
      <p><%= t(".desc") %></p>
    </div>

    <%= render "shared/flash" %>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email, t(".email_address"), class: "form-label fw-semibold" %>
        <%= form.email_field :email_address, title: "", value: params[:email_address], class: "form-control",
                           required: true, autofocus: true, autocomplete: "email",
                           **email_validation %>
      </div>
        <%= form.submit t(".send"), class: "btn btn-success w-100 fw-semibold" %>
    <% end %>
  </div>
</div>
<div class="position-absolute top-0 end-0 py-2 px-3">
  <%= render "shared/preferences" %>
</div>
