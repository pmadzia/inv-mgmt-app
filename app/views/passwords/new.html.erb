<div class="d-flex justify-content-center py-4">
  <div class="auth-box w-100 px-3 py-1">
    <div class="text-center mb-4">
      <%= link_to root_path, class: "text-body text-decoration-none",
                             aria: { label: "Inventories home" } do %>
        <i class="bi bi-box-seam fs-1"></i>
      <% end %>
      <h1 class="h5 fw-semibold mt-3">Reset your password</h1>
      <p>Enter your user account's verified email address and we will send you a password reset link.</p>
    </div>

    <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email, "Email address", class: "form-label fw-semibold" %>
        <%= form.email_field :email_address, value: params[:email_address], class: "form-control",
                           required: true, autofocus: true, autocomplete: "email" %>
      </div>
        <%= form.submit "Send", class: "btn btn-success w-100 fw-semibold" %>
    <% end %>
  </div>
</div>
