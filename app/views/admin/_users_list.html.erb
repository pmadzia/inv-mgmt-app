<div id="users_list" class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th><input type="checkbox" class="form-check-input"
                   data-bulk-select-target="checkboxAll" data-action="bulk-select#toggle"></th>
        <th><%= sort_link(q, :name) %></th>
        <th><%= sort_link(q, :email_address) %></th>
        <th><%= sort_link(q, :created_at) %></th>
        <th>Admin</th>
        <th>Blocked</th>
      </tr>
    </thead>
    <tbody>
      <% users.each do |user| %>
        <tr>
          <td><%= check_box_tag "user_ids[]", user.id, false, id: "user_#{user.id}", form: "bulk-form",
                class: "form-check-input",
                data: { bulk_select_target: "checkbox", action: "bulk-select#refresh" } %></td>
          <td><%= link_to user.name, user_path(user) %></td>
          <td><%= user.email_address %></td>
          <td><%= l user.created_at, format: :short %></td>
          <td><%= "✓" if user.admin? %></td>
          <td><%= "✓" if user.blocked? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>