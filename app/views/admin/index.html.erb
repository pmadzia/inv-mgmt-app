<div class="d-flex justify-content-center py-4">
  <div class="admin-box w-100 px-3">
    <%= render "shared/flash" %>
    <div class="text-left mb-4 py-1">
      <h1 class="h2 fw-semibold mt-3"><%= t(".users") %></h1>
    </div>
    <div data-controller="bulk-select">
      <%= form_with url: unblock_selected_admin_path, method: :post, id: "bulk-form" do %>
        <div class="d-flex gap-2 mb-3">
          <button type="submit" formaction="<%= block_selected_admin_path %>"
            class="btn btn-secondary" data-bulk-select-target="action" disabled>
              <%= t(".block") %>
          </button>
          <button type="submit" formaction="<%= unblock_selected_admin_path %>"
            class="btn btn-secondary" data-bulk-select-target="action" disabled>
              <%= t(".unblock") %>
          </button>
          <button type="submit" formaction="<%= promote_selected_admin_path %>"
            class="btn btn-secondary" data-bulk-select-target="action" disabled>
              <%= t(".add_admin") %>
          </button>
          <button type="submit" formaction="<%= demote_selected_admin_path %>"
            class="btn btn-secondary" data-bulk-select-target="action" disabled>
              <%= t(".remove_admin") %>
          </button>
          <button type="submit" formaction="<%= delete_selected_admin_path %>"
            class="btn btn-danger" data-bulk-select-target="action" disabled>
              <%= t(".delete") %>
          </button>
        </div>
      <% end %>
      <%= render "admin/users_list", q: @q, users: @users %>
    </div>
  </div>
</div>
